  "openapi": "3.1.0",
  "info": {
    "title": "Matrix Authentication Service",
    "description": "Paths and methods served by each listener resource, tagged with the resource's `name` in the configuration. Request and response bodies are not documented. The admin API is described in `spec.json`.",
    "version": ""
  },
  "servers": [
    {
      "url": "{base}",
      "variables": {
        "base": {
          "default": "/",
          "description": "The base URL of the listener"
        }
      }
    }
  ],
