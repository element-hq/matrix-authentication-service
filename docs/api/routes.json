    "/.well-known/webfinger": {
      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "Discover the OpenID Connect issuer of an entity",
        "parameters": [
          {
            "in": "query",
            "name": "resource",
            "description": "The URI of the entity to describe",
            "required": true,
            "schema": {
              "description": "The URI of the entity to describe",
              "type": "string"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "rel",
            "description": "The relation type of the links to return. Only\n`http://openid.net/specs/connect/1.0/issuer` is supported, and no links\nare returned without it.",
            "schema": {
              "description": "The relation type of the links to return. Only\n`http://openid.net/specs/connect/1.0/issuer` is supported, and no links\nare returned without it.",
              "type": "string"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "description": "The response of the Webfinger endpoint.",
            "content": {
              "application/jrd+json": {
                "schema": {
                  "$ref": "#/components/schemas/WebFingerResponse"
                }
              }
            }
          }
        }
      }
    },
